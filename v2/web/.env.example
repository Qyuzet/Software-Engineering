# On the server this file is ~/crowd-intelligent/web/.env (chmod 600). Locally: .env.local

# Postgres on etzal (database "crowd", role "crowd"). Empty = demo data.
DATABASE_URL=postgresql://crowd:PASSWORD@127.0.0.1:5432/crowd

# Shared secret: the laptop sends it to stream video (/live/ingest) and upload logs (/api/logs).
# Generate one with:  openssl rand -hex 24
EDGE_TOKEN=

# Seconds between log rows (must match LOG_INTERVAL_S in edge/config.py)
LOG_INTERVAL_S=10

# Where server.js listens (cloudflared points here)
HOST=127.0.0.1
PORT=3020
