# Copy to v2/edge/.env. Anything left out here is read from the project's root .env
# (CAMERA_SOURCE, ESP32_MODE, ESP32_HOST, SERIAL_PORT keep working as before).

# ---- New in v2: the server hub on etzal ----
HUB_URL=https://crowd.etzalgroup.com
EDGE_TOKEN=paste-the-token-from-the-server

# ---- Camera ----
# Either the full URL...
# CAMERA_SOURCE=http://10.31.176.62:8080/video
# ...or just the phone's IP (IP Webcam app, port 8080):
# PHONE_IP=10.31.176.62
# CAMERA_SOURCE=sim        # fake people, for testing without phone or YOLO

# ---- ESP32: wifi | usb | off ----
# ESP32_MODE=wifi
# ESP32_HOST=10.31.176.176
# SERIAL_PORT=COM3

# ---- Optional ----
# SHOW_WINDOW=false        # no desktop pop-up, the website is the screen
# CROWD_LIMIT=10
# SITE_NAME=Lecture Hall A
# IMAGE_SIZE=640           # faster YOLO on a weak laptop
# UPLINK_MAX_FPS=8         # lower on a slow hotspot
# UPLINK_WIDTH=960
