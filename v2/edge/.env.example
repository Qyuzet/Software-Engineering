# Copy to v2/edge/.env (run.bat does it for you). The root .env is read too, but is not needed.

# ---- Phone camera (IP Webcam app: Start server, it shows http://<IP>:8080) ----
PHONE_IP=10.31.176.62
# or a full URL instead:   CAMERA_SOURCE=http://10.31.176.62:8080/video
# no phone at hand:        CAMERA_SOURCE=sim     (fake people, no YOLO needed)

# ---- ESP32: wifi | usb | off ----
ESP32_MODE=wifi
# wifi: the address the ESP32 prints in the Arduino Serial Monitor (115200 baud)
ESP32_HOST=10.31.176.176
# usb: the COM port (Device Manager -> Ports)
SERIAL_PORT=COM3

# ---- Worker on etzal (live video + database) ----
WORKER_URL=https://crowd-api.etzalgroup.com
# ssh -p 2222 mydebian 'grep EDGE_TOKEN ~/crowd-intelligent/worker.env'
EDGE_TOKEN=

# ---- Optional ----
# SHOW_WINDOW=false        # no desktop pop-up, the website is the screen
# CROWD_LIMIT=10
# SITE_NAME=Lecture Hall A
# IMAGE_SIZE=640           # faster YOLO on a weak laptop
# UPLINK_MAX_FPS=8         # lower on a slow hotspot
# UPLINK_WIDTH=960
