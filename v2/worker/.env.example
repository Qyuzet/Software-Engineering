# On etzal this file is ~/crowd-intelligent/worker.env (chmod 600, created by setup-server.sh).
# Locally: copy to v2/worker/.env

# Postgres (database "crowd", role "crowd"). Empty = /api/metrics serves demo data.
DATABASE_URL=postgresql://crowd:PASSWORD@127.0.0.1:5432/crowd

# Shared secret with the laptop (edge/.env): needed to stream video and upload logs.
# Generate one with:  openssl rand -hex 24
EDGE_TOKEN=

# Seconds between log rows (must match LOG_INTERVAL_S in edge/config.py)
LOG_INTERVAL_S=10

# Which websites may read /api/metrics and /live/status from the browser.
# * = any (the data is public and read-only). Or a list:
# CORS_ORIGINS=https://crowd.etzalgroup.com,http://localhost:3000
CORS_ORIGINS=*

# Where the worker listens (the Cloudflare tunnel points here)
HOST=127.0.0.1
PORT=3020
