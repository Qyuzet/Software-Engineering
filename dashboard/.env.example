# Copy this file to .env.local and fill it in.

# Neon connection string (the same one the Python script uses).
# Leave it empty to run the dashboard on demo data.
DATABASE_URL=

# Optional: if set, POST /api/logs requires the header  x-api-key: <this value>
INGEST_API_KEY=

# Seconds between log rows (must match LOG_INTERVAL_S in config.py)
LOG_INTERVAL_S=10

# Where the Python script serves the live camera feed and status
NEXT_PUBLIC_EDGE_URL=http://127.0.0.1:8080
